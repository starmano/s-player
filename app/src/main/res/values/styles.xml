<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TracksPanelHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TracksPanelOption" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/brand</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/panel_option_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
